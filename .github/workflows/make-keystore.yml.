name: Build APK

on:
  workflow_dispatch:
  push:
    branches:
      - main
    tags:
      - 'v*'

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Check out repo
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Install Flet
        run: pip install "flet[all]==0.28.3"

      - name: Install app dependencies
        run: pip install -r requirements.txt

      - name: Decode signing key
        run: echo "${{ secrets.KEYSTORE_BASE64 }}" | base64 -d > "$RUNNER_TEMP/storystrand.jks"

      - name: Build APK
        run: |
          yes | flet build apk \
            --project "StoryStrand" \
            --org com.storystrand.app \
            --build-number ${{ github.run_number }} \
            --android-signing-key-store "$RUNNER_TEMP/storystrand.jks" \
            --android-signing-key-store-password "${{ secrets.KEYSTORE_PASSWORD }}" \
            --android-signing-key-password "${{ secrets.KEYSTORE_PASSWORD }}" \
            --android-signing-key-alias storystrand

      - name: Save APK as artifact
        uses: actions/upload-artifact@v4
        with:
          name: StoryStrand-apk
          path: build/apk/*.apk

      - name: Upload APK to Release
        if: startsWith(github.ref, 'refs/tags/')
        uses: softprops/action-gh-release@v2
        with:
          files: build/apk/*.apk
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
